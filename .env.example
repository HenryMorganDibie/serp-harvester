# Copy to .env (or export directly) once you have a key from a
# SerpApi-compatible provider (SerpApi, Serper.dev, DataForSEO, etc.).
# The variable name must match provider_api_key_env in your config
# (defaults to SERPAPI_KEY in configs/config.example.yaml).
#
# Nothing in this repo requires a key: mock mode runs with none, and
# `go test ./...` never touches the network. This only matters once
# `mode: provider` is used.
SERPAPI_KEY=
