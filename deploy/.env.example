# Copy to deploy/.env before running `docker compose -f deploy/docker-compose.yml up -d`.
# Never commit the real .env — it's gitignored.

# Required: Postgres password for the harvester/api/postgres services.
POSTGRES_PASSWORD=

# Optional: set once you have a key, to run `mode: provider` in deploy/config.yaml.
SERPAPI_KEY=

# Optional: set to true only after reviewing the target's Terms of Service,
# to let the opt-in harvester-playwright service (--profile playwright)
# send real requests. It passes this as -i-have-reviewed-tos.
HARVESTER_REVIEWED_TOS=false

# Required: Grafana admin password. There is no default; compose refuses to
# start without it.
GRAFANA_ADMIN_PASSWORD=
