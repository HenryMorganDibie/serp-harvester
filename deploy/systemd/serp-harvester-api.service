[Unit]
Description=serp-harvester-api (job submission HTTP layer)
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
User=harvester
Group=harvester
WorkingDirectory=/opt/serp-harvester
ExecStart=/opt/serp-harvester/bin/api -addr :8080 -redis-addr localhost:6379 -redis-stream serp-harvester:queries -postgres-dsn-env POSTGRES_DSN
Restart=on-failure
RestartSec=5s

# Postgres DSN (for job-status completion counts) and any other secrets:
# /etc/serp-harvester.env, mode 600, not in git.
EnvironmentFile=-/etc/serp-harvester.env

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
